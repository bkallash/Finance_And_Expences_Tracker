<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="950.0" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TransactionsController">

    <top>
        <VBox alignment="CENTER">
            <children>
                <Label styleClass="compact-page-title" text="Transactions Management">
                    <VBox.margin>
                        <Insets bottom="6.0" top="12.0" />
                    </VBox.margin>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="nav-bar">
                    <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                    </padding>
                    <children>
                        <Button fx:id="refreshButton" onAction="#onRefreshButtonClick" prefWidth="90.0" styleClass="secondary-button compact-button" text="Refresh" />
                        <Button fx:id="summaryButton" onAction="#onGenerateSummaryButtonClick" prefWidth="170.0" styleClass="secondary-button compact-button" text="Category Summary" />
                        <Button fx:id="cancelButton" disable="true" onAction="#onCancelButtonClick" prefWidth="80.0" styleClass="secondary-button compact-button" text="Cancel" />
                        <ProgressIndicator fx:id="loadingIndicator" prefHeight="24.0" prefWidth="24.0" visible="false" />
                        <Label fx:id="statusLabel" styleClass="message-label" />
                        <Pane HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="12.0" styleClass="sidebar-card">
            <padding>
                <Insets bottom="16.0" left="12.0" right="12.0" top="16.0" />
            </padding>

            <children>
                <Label styleClass="section-title" text="Transaction Details" />

                <TextField fx:id="amountField" promptText="Enter amount" styleClass="field-input" />

                <ComboBox fx:id="categoryComboBox" prefWidth="210.0" promptText="Select category" styleClass="field-input" />

                <ComboBox fx:id="typeComboBox" prefWidth="210.0" promptText="Select type" styleClass="field-input" />

                <HBox alignment="CENTER" spacing="8.0">
                    <children>
                        <DatePicker fx:id="transactionDatePicker" prefWidth="132.0" styleClass="field-input" />
                        <Button fx:id="todayButton" onAction="#onTodayButtonClick" prefWidth="72.0" prefHeight="34.0" styleClass="today-button" text="Today" />
                    </children>
                </HBox>

                <Button fx:id="addEditTransactionButton" onAction="#onAddEditTransactionButtonClick" prefWidth="180.0" styleClass="primary-button compact-button" text="Add / Edit Transaction" />

                <Button fx:id="clearButton" onAction="#onClearButtonClick" prefWidth="180.0" styleClass="secondary-button compact-button" text="Clear" />

                <Button fx:id="deleteTransactionButton" onAction="#onDeleteTransactionButtonClick" prefWidth="180.0" styleClass="primary-button compact-button" text="Delete Transaction" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="10.0" styleClass="content-card">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" prefWidth="560.0">
                    <children>
                        <TextField fx:id="searchTransactionField"
                                   promptText="Search by category name or date"
                                   styleClass="field-input"
                                   HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="sortTransactionComboBox"
                                  prefWidth="155.0"
                                  promptText="Sort"
                                  styleClass="field-input" />
                    </children>
                </HBox>

                <TableView fx:id="transactionsTable" prefHeight="400.0" prefWidth="560.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="52.0" text="ID" />
                        <TableColumn fx:id="categoryNameColumn" prefWidth="160.0" text="Category Name" />
                        <TableColumn fx:id="amountColumn" prefWidth="100.0" text="Amount" />
                        <TableColumn fx:id="typeColumn" prefWidth="95.0" text="Type" />
                        <TableColumn fx:id="dateColumn" prefWidth="170.0" text="Date" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>

            <children>
                <Button fx:id="backButton" onAction="#onBackButtonClick" prefWidth="120.0" styleClass="secondary-button compact-button" text="Back" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
