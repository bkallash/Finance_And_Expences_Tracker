<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_LEFT" prefHeight="620.0" prefWidth="980.0" spacing="15.0" styleClass="report-root" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReportsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <Label styleClass="compact-page-title" text="Financial Reports" />
        <Label styleClass="sub-heading" text="Generate detailed text-based reports from your financial data." />

        <VBox spacing="10.0" styleClass="content-card">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Report Type" />
                                <ComboBox fx:id="reportTypeComboBox" prefWidth="200.0" promptText="Select Report Type" />
                            </children>
                        </VBox>
                        <VBox fx:id="categoryFilterContainer" spacing="5.0">
                            <children>
                                <Label text="Category (Optional)" />
                                <ComboBox fx:id="categoryComboBox" prefWidth="200.0" promptText="All Categories" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="From Date" />
                                <DatePicker fx:id="fromDatePicker" prefWidth="150.0" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="To Date" />
                                <DatePicker fx:id="toDatePicker" prefWidth="150.0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="generateButton" onAction="#handleGenerateReport" styleClass="action-button" text="Generate Report" />
                        <Button fx:id="cancelButton" onAction="#handleCancelReport" styleClass="cancel-button" text="Cancel" />
                        <ProgressIndicator fx:id="progressIndicator" prefHeight="24.0" prefWidth="24.0" visible="false" />
                        <Label fx:id="statusLabel" styleClass="status-label" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <TextArea fx:id="reportTextArea" editable="false" prefHeight="400.0" prefWidth="940.0" promptText="Report output will appear here..." styleClass="report-text-area" VBox.vgrow="ALWAYS">
            <font>
                <Font name="Monospaced Regular" size="13.0" />
            </font>
        </TextArea>
    </children>
</VBox>
